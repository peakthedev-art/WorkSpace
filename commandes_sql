CREATE TABLE role (
    id CHAR(36) NOT NULL PRIMARY KEY,
    name VARCHAR(255) NOT NULL
);


CREATE TABLE badge (
    id CHAR(36) NOT NULL PRIMARY KEY,
    activation_date DATE NOT NULL DEFAULT (CURRENT_DATE),
    ending_date DATE NOT NULL,
    role_id CHAR(36) NOT NULL,
    FOREIGN KEY (role_id) REFERENCES role(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE
);

CREATE TABLE user (
    id CHAR(36) NOT NULL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    surname VARCHAR(255) NOT NULL,
    birthdate DATE NOT NULL,
    sex VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    badge_id CHAR(36) NOT NULL, 
    FOREIGN KEY (badge_id) REFERENCES badge(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE
);

CREATE TABLE zone (
    id CHAR(36) NOT NULL PRIMARY KEY,
    name VARCHAR(255) NOT NULL
);

CREATE TABLE location (
    id CHAR(36) NOT NULL PRIMARY KEY,
    owner_id CHAR(36) NOT NULL,
    FOREIGN KEY (owner_id) REFERENCES user(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE
);

CREATE TABLE access_zone (
    role_id CHAR(36) NOT NULL,
    zone_id CHAR(36) NOT NULL,
    FOREIGN KEY (role_id) REFERENCES role(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE,
    FOREIGN KEY (zone_id) REFERENCES zone(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE
);

CREATE TABLE access_event (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    badge_id CHAR(36) NULL,
    zone_id CHAR(36) NULL,
    scanned_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
    authorized BOOLEAN NOT NULL,
    response_code SMALLINT UNSIGNED NOT NULL,
    response_message VARCHAR(255) NOT NULL,
    request_id CHAR(36) NULL,
    source_ip VARCHAR(45) NULL,
    FOREIGN KEY (badge_id) REFERENCES badge(id)
        ON DELETE SET NULL
        ON UPDATE CASCADE,
    FOREIGN KEY (zone_id) REFERENCES zone(id)
        ON DELETE SET NULL
        ON UPDATE CASCADE,
    INDEX idx_access_event_scanned_at (scanned_at),
    INDEX idx_access_event_badge_scanned_at (badge_id, scanned_at),
    INDEX idx_access_event_zone_scanned_at (zone_id, scanned_at),
    INDEX idx_access_event_authorized_scanned_at (authorized, scanned_at)
);

